---
---
{% assign cascade_manifest = site.data['cascade-build'] %}
{% assign cascade_revision = site.github.build_revision | default: cascade_manifest.commit %}
{% assign cascade_commit = cascade_revision | slice: 0, 7 %}
{
  "product": "CASCADE",
  "version": "{{ cascade_manifest.version }}",
  "commit": "{{ cascade_commit }}",
  "builtAt": "{{ cascade_manifest.builtAt }}",
  "productionUrl": "{{ cascade_manifest.productionUrl }}",
  "features": [
{% for feature in cascade_manifest.features %}    "{{ feature }}"{% unless forloop.last %},{% endunless %}
{% endfor %}  ]
}
